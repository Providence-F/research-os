# Research OS configuration.
# Copy this file to `.env` and adjust values, or export the variables in your shell.

# Root directory of the Research OS install. Defaults to the repo directory.
# Override only if you installed Research OS somewhere unusual.
# RESEARCH_OS_HOME=/path/to/research-os

# Template library location. Defaults to <RESEARCH_OS_HOME>/templates.
# Point this at your Obsidian vault if you keep templates there.
# RESEARCH_OS_TEMPLATES=E:/obsidian/AI革命生存指南/09-收件箱/Research OS 深度调研工作流/04-模板库

# Default directory where new research projects are scaffolded.
# Defaults to <RESEARCH_OS_HOME>/projects.
# RESEARCH_OS_PROJECTS_DIR=E:/obsidian/AI革命生存指南/09-收件箱/research-projects

# MiMo search API key file path. Used by mimo_search.js.
# Defaults to <RESEARCH_OS_HOME>/.mimo_search_key.
# Create this file and paste your MiMo API key into it.
# MIMO_KEY_PATH=/path/to/your/key

# Temp payload file for MiMo API calls. Defaults to <RESEARCH_OS_HOME>/_mimo_payload.json.
# MIMO_PAYLOAD_PATH=/tmp/mimo_payload.json
